# Copiez ce fichier en ".env" et remplissez les valeurs. NE COMMITEZ JAMAIS .env
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=BaseInventaire1

# Optionnel : envoi d'email (mot de passe d'application Gmail, pas votre mot de passe principal)
SMTP_USER=votre.adresse@gmail.com
SMTP_PASSWORD=mot-de-passe-application
ALERT_RECIPIENT=destinataire@gmail.com
